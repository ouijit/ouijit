---
import Site from '../../layouts/Site.astro';
import WorkspaceScene from '../../components/demo/WorkspaceScene.tsx';
import WorktreeSpawnDemo from '../../components/demo/WorktreeSpawnDemo.tsx';
import StackDemo from '../../components/demo/StackDemo.tsx';
import AgentStatesDemo from '../../components/demo/AgentStatesDemo.tsx';
import AutomationDemo from '../../components/demo/AutomationDemo.tsx';
import DiffNoteDemo from '../../components/demo/DiffNoteDemo.tsx';
import CliTypingDemo from '../../components/demo/CliTypingDemo.tsx';
import FloatNav from '../../components/home/FloatNav.astro';
import DownloadButtons from '../../components/home/DownloadButtons.astro';
import Bento from '../../components/home/Bento.astro';
import Harnesses from '../../components/home/Harnesses.astro';
import Cta from '../../components/home/Cta.astro';

const HEADLINE = 'Command parallel coding agents, on your terms';
---
<Site noindex>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <FloatNav />

  <section class="hero">
    <h1 class="b-h1" aria-label={HEADLINE}>
      <span class="b-h1-ghost" aria-hidden="true">{HEADLINE}</span>
      <span class="b-h1-typed" aria-hidden="true"><span class="b-h1-text"></span><span class="b-h1-caret"></span></span>
    </h1>
    <p class="hero-subtitle" data-reveal style="--reveal-delay: 90ms">Run Claude, Codex, Pi, and OpenCode in parallel: by hand, with scripts, or through delegation.</p>
    <div data-reveal style="--reveal-delay: 180ms">
      <DownloadButtons />
    </div>
    <p class="hero-fine-print" data-reveal style="--reveal-delay: 260ms">Free and open source. No account, no sign-in, no telemetry.</p>
  </section>

  <section class="hero-scene">
    <WorkspaceScene client:visible />
  </section>

  <section class="home-pitch b-pitch">
    <p class="b-pitch-text">
      Ouijit is a task and terminal manager for running coding agents in parallel. Each task gets its own git
      worktree and terminal, lifecycle hooks launch your agent with the right context, and a session-aware CLI
      lets agents drive the board back. Live status, notifications, diff review, and per-terminal sandboxing
      are built in.
    </p>
    <a class="home-pitch-link" href="/docs/" data-reveal>Read the docs <span aria-hidden="true">→</span></a>
  </section>

  <section class="lc">
    <div class="lc-head">
      <h2 data-reveal>From To Do to Done.</h2>
    </div>
    <div class="lc-scroll">
      <div class="lc-sticky">
        <div class="lc-inner">
          <div class="lc-rail" aria-hidden="true">
            <div class="lc-rail-row" style="--row-color: #0a84ff">
              <span class="lc-dot"></span>To Do
            </div>
            <div class="lc-rail-row" style="--row-color: #da77f2">
              <span class="lc-dot"></span>In Progress
            </div>
            <div class="lc-rail-row" style="--row-color: #3fb950">
              <span class="lc-dot"></span>In Review
            </div>
            <div class="lc-rail-row" style="--row-color: #4ee82e">
              <span class="lc-dot"></span>Done
            </div>
          </div>
          <div class="lc-panels">
            <div class="lc-panel" style="--glow: #0a84ff">
              <h3>Drag a card. Get a workspace.</h3>
              <p>
                Starting a task creates an isolated git worktree — a copy-on-write clone,
                <code>node_modules</code> intact — and opens a terminal in it.
              </p>
              <div class="stage-card lc-card">
                <WorktreeSpawnDemo client:visible />
              </div>
            </div>
            <div class="lc-panel" style="--glow: #da77f2">
              <h3>Run four agents like you'd run one.</h3>
              <p>
                Live status on every card and terminal — thinking, editing, running tests — and a notification
                when a turn ends.
              </p>
              <div class="stage-card lc-card">
                <AgentStatesDemo client:visible />
              </div>
            </div>
            <div class="lc-panel" style="--glow: #3fb950">
              <h3>Notes land where the agent works.</h3>
              <p>
                A word-level diff against the merge target. Leave a note on a changed line; the agent in that
                worktree picks it up.
              </p>
              <div class="stage-card lc-card">
                <DiffNoteDemo client:visible />
              </div>
            </div>
            <div class="lc-panel" style="--glow: #4ee82e">
              <h3>Hooks move it over the line.</h3>
              <p>
                Five lifecycle hooks — start, continue, run, review, done — launch agents, dev servers, and
                pushes as cards move.
              </p>
              <div class="stage-card lc-card">
                <AutomationDemo client:visible />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stage" style="--glow: #da77f2">
    <div class="stage-head">
      <h2 data-reveal>The agent, its plan, and the app it's building.</h2>
      <p class="stage-lead" data-reveal style="--reveal-delay: 80ms">
        Each terminal is a card in a stack. Panels attach as tabs — a runner for the dev server, a web preview,
        and markdown files with Mermaid diagrams — so context sits <strong>beside the agent using it</strong>.
      </p>
    </div>
    <div class="stage-card" data-reveal style="--reveal-delay: 140ms">
      <StackDemo client:visible />
    </div>
    <div class="stage-foot" data-reveal>
      <p>Shells outside any task get their own strip on the board. Tag sessions to filter them.</p>
      <a class="exposition-link" href="/docs/panels/">Panel docs <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="stage" style="--glow: #bd93f9">
    <div class="stage-head">
      <h2 data-reveal>Shape the app by asking your agent.</h2>
      <p class="stage-lead" data-reveal style="--reveal-delay: 80ms">
        Every terminal Ouijit opens has the <code>ouijit</code> command on PATH, and the supported harnesses
        learn it automatically. Agents can file follow-up tasks, move their own card, stage review comments, or
        open panels beside themselves.
      </p>
    </div>
    <div class="stage-card stage-card--narrow" data-reveal style="--reveal-delay: 140ms">
      <CliTypingDemo client:visible />
    </div>
    <div class="stage-foot" data-reveal>
      <p>It works from your shell too, with JSON output.</p>
      <a class="exposition-link" href="/docs/cli/">CLI docs <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <Bento />
  <Harnesses />
  <Cta />

  <script>
    import { initHomeChrome, initPitchIllumination, scrollProgress } from '../../scripts/homeChrome';
    initHomeChrome();
    initPitchIllumination();

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Typed hero: the ghost span reserves the final layout; the overlay types
    // the same text over it.
    const h1 = document.querySelector('.b-h1');
    const typedText = document.querySelector('.b-h1-text');
    const ghost = document.querySelector('.b-h1-ghost');
    if (h1 && typedText && ghost && !reduceMotion) {
      const full = (ghost.textContent ?? '').trim();
      h1.classList.add('is-typing');
      let i = 0;
      const type = () => {
        i += 1;
        typedText.textContent = full.slice(0, i);
        if (i < full.length) {
          window.setTimeout(type, 22);
        } else {
          h1.classList.add('is-done');
        }
      };
      window.setTimeout(type, 300);
    }

    // Lifecycle chapters: scroll position through the tall section picks the
    // active chapter; rows and panels follow.
    const lc = document.querySelector<HTMLElement>('.lc-scroll');
    const rows = [...document.querySelectorAll<HTMLElement>('.lc-rail-row')];
    const panels = [...document.querySelectorAll<HTMLElement>('.lc-panel')];
    let chapter = -1;

    const onScroll = () => {
      if (lc && panels.length && window.innerWidth > 900) {
        const idx = Math.min(panels.length - 1, Math.floor(scrollProgress(lc) * panels.length));
        if (idx !== chapter) {
          chapter = idx;
          rows.forEach((row, i) => {
            row.toggleAttribute('data-on', i === idx);
            row.toggleAttribute('data-past', i < idx);
          });
          panels.forEach((panel, i) => panel.toggleAttribute('data-on', i === idx));
        }
      }
    };
    document.addEventListener('scroll', onScroll, { capture: true, passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
  </script>
</Site>
