---
import Site from '../layouts/Site.astro';
import DownloadButtons from '../components/home/DownloadButtons.astro';
import Cta from '../components/home/Cta.astro';
import { SandboxMock } from '../components/demo/SandboxMocks.tsx';

const features: { title: string; body: string; mock: 'grants' | 'where' | 'agent' | 'fails' | 'custom' }[] = [
  {
    title: 'Bounded to the worktree',
    body: "The agent reads and writes the task's worktree and commits to it. Git hooks and config stay read-only. Your home directory, keys and other repositories are blocked. Network access is up to the project's profile.",
    mock: 'grants',
  },
  {
    title: 'Choose what runs where',
    body: 'Set a default per project, then override it per hook, per script or per run. Sandbox the agent and keep the dev server and the push on the host, where the credentials are.',
    mock: 'where',
  },
  {
    title: 'The agent still drives Ouijit',
    body: 'A sandboxed agent keeps the ouijit command, on a token scoped to its project. It reads diff notes, stages review comments for you to send, and asks you to run what it cannot. Widen its access per project.',
    mock: 'agent',
  },
  {
    title: 'Fails closed',
    body: 'If the sandbox cannot start, the command does not run and the terminal says why. Ouijit never falls back to the host.',
    mock: 'fails',
  },
  {
    title: 'Bring your own launcher',
    body: 'Teams with their own sandboxing set a Custom launcher that owns the boundary. Ouijit passes the worktree, the git directories and the ports as hints and adds nothing of its own.',
    mock: 'custom',
  },
];

const points: [string, string][] = [
  [
    'Kernel-enforced',
    'Seatbelt on macOS and Landlock on Linux, through nono. The limits are an operating-system policy on the process, not a prompt and not a classifier.',
  ],
  [
    'In place',
    'The agent runs in the real worktree as a normal process, with your tools and its own sign-ins. No virtual machine, no file sync, no second environment to maintain.',
  ],
  [
    'Policy outside the repository',
    "Each project's profile lives in your config directory, where the agent cannot edit it. Open it from settings to block the network, open ports or grant folders.",
  ],
];

const faqs: [string, string][] = [
  [
    "Does this replace Claude Code's own sandbox?",
    "It holds more. Claude Code's sandbox covers the shell commands it runs; its file tools, MCP servers and hooks run outside it. Ouijit's sandbox holds the whole terminal, so everything the agent starts is inside. You can run both.",
  ],
  [
    'Which agents does it work with?',
    "Any command. Claude Code, Codex, Pi and OpenCode sign in and run under Ouijit's base profile with nothing to configure. Anything else is a matter of granting what it needs in the project's profile.",
  ],
  [
    'Can the agent reach the network?',
    "Yes by default. Block it, or allow specific ports, in the project's profile. Ouijit keeps its own status port reachable so the card still shows what the agent is doing.",
  ],
  [
    'Does it slow anything down?',
    'No. The sandbox is a kernel access policy on a normal process in the real worktree. There is nothing to boot and nothing to sync, so a sandboxed terminal opens as fast as any other.',
  ],
  ['What does it need?', 'macOS, or Linux with kernel 5.13 or newer. nono is bundled with Ouijit; there is nothing to install.'],
  [
    'Can the agent change its own sandbox?',
    'No. The profile lives outside every worktree, and .git hooks and config are read-only inside the sandbox, so it cannot grant itself access or plant a hook that runs on the host.',
  ],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Site
  title="Sandbox · Ouijit"
  description="Run coding agents with their permission checks off. Ouijit's sandbox holds the agent to its task's worktree with kernel-level limits, while the dev server beside it stays on the host.">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero">
    <h1>Run agents with their permission checks off.</h1>
    <p class="hero-sub">
      Ouijit's sandbox holds an agent to its task's worktree, enforced by the kernel. The rest of your machine
      is out of reach.
    </p>
    <DownloadButtons />
    <p class="hero-fine-print">Free and open source. No account, no sign-in, no telemetry.</p>
  </section>

  <div class="feature-hero-visual">
    <div class="plan-desk desk-wash">
      <div class="desk-wash-field" aria-hidden="true" style="--wash: var(--wash-iris)"><span class="desk-wash-grain"></span></div>
      <div class="relative"><SandboxMock kind="hero" client:visible /></div>
    </div>
  </div>

  <section class="feature-section">
    <h2>Turn it on</h2>
    <div class="steps">
      <div class="step">
        <p>
          Set the project's default to Sandbox under <strong>Project Settings → Sandbox</strong>, or set it on the
          start hook alone. The hook that launches the agent can then skip the prompts.
        </p>
        <pre><code>claude --dangerously-skip-permissions "$OUIJIT_TASK_DESCRIPTION"</code></pre>
      </div>
      <div class="step">
        <p>Or sandbox one command and leave the rest of the line on the host.</p>
        <pre><code>git pull origin main &amp;&amp; ouijit sandbox -- claude --dangerously-skip-permissions "$OUIJIT_TASK_DESCRIPTION"</code></pre>
      </div>
    </div>
  </section>

  <section class="feature-section">
    <div class="feature-rows">
      {features.map((f) => (
        <div class="feature-row">
          <div class="feature-copy">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
          <div class="feature-visual">
            <div class="plan-desk desk-wash desk-wash--graphite">
              <div class="desk-wash-field" aria-hidden="true"><span class="desk-wash-grain"></span></div>
              <div class="relative"><SandboxMock kind={f.mock} client:visible /></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="feature-section">
    <h2>How it works</h2>
    <div class="points">
      {points.map(([title, body]) => (
        <p><strong>{title}</strong>{body}</p>
      ))}
    </div>
  </section>

  <section class="feature-section feature-faq">
    <h2>Questions</h2>
    {faqs.map(([q, a]) => (
      <section class="faq-item">
        <h3>{q}</h3>
        <p>{a}</p>
      </section>
    ))}
  </section>

  <Cta />
</Site>
