---
import Site from '../layouts/Site.astro';
import DownloadButtons from '../components/home/DownloadButtons.astro';
import Cta from '../components/home/Cta.astro';
import { SandboxMock } from '../components/demo/SandboxMocks.tsx';

const features: { title: string; body: string; mock: 'grants' | 'where' | 'agent' | 'fails' | 'custom' }[] = [
  {
    title: 'Bounded to the worktree',
    body: "The agent can read, write and commit inside the task's worktree. Git hooks and config are read-only. Home, keys and other repositories are blocked. The network is yours to allow or not, per project.",
    mock: 'grants',
  },
  {
    title: 'Choose what runs where',
    body: 'A default per project, overridable per hook, script or run. Sandbox the agent. Keep the dev server and the push on the host, where the credentials are.',
    mock: 'where',
  },
  {
    title: 'The agent still drives Ouijit',
    body: "The ouijit command works inside, on a token scoped to the project. The agent reads your diff notes, stages review comments for you to send, and asks you to run what it can't. How much more it may do is a project setting.",
    mock: 'agent',
  },
  {
    title: 'Fails closed',
    body: "If the sandbox can't start, the command doesn't run and the terminal says why. There is no fallback to the host.",
    mock: 'fails',
  },
  {
    title: 'Bring your own launcher',
    body: 'A Custom launcher runs every sandboxed command through a script your team maintains. The script owns the boundary. Ouijit passes it the worktree, git directories and ports as hints.',
    mock: 'custom',
  },
];

const points: [string, string][] = [
  [
    'Kernel-enforced',
    'Seatbelt on macOS, Landlock on Linux, via nono. The limits are an OS policy on the process, not a prompt or a classifier.',
  ],
  [
    'In place',
    'The agent runs in the real worktree as a normal process, with your tools and its own sign-ins. No VM, no file sync, no second environment.',
  ],
  [
    'Policy outside the repository',
    "Each project's profile lives in your config directory, out of the agent's reach. Edit it to block the network, open ports or grant folders.",
  ],
];

const faqs: [string, string][] = [
  [
    "Does this replace Claude Code's own sandbox?",
    "It covers more. Claude Code's sandbox wraps the shell commands it runs; its file tools, MCP servers and hooks run outside it. Ouijit's wraps the whole terminal, so everything the agent starts is inside. The two can run together.",
  ],
  [
    'Which agents does it work with?',
    "Any command. Claude Code, Codex, Pi and OpenCode sign in and run with nothing to configure. Anything else needs its paths granted in the project's profile.",
  ],
  [
    'Can the agent reach the network?',
    "By default, yes. Block it or allow specific ports in the project's profile. Ouijit's own status port stays reachable, so the card still shows what the agent is doing.",
  ],
  [
    'Does it slow anything down?',
    'No. There is nothing to boot and nothing to sync. A sandboxed terminal opens as fast as any other.',
  ],
  ['What does it need?', 'macOS, or Linux with kernel 5.13 or newer. nono ships inside Ouijit.'],
  [
    'Can the agent change its own sandbox?',
    "No. The profile lives outside every worktree, and .git hooks and config are read-only inside, so it can't grant itself access or plant a hook that runs on the host.",
  ],
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<Site
  title="Sandbox · Ouijit"
  description="Run coding agents with their permission checks off. Ouijit's sandbox holds the agent to its task's worktree with kernel-level limits, while the dev server beside it stays on the host.">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="hero">
    <h1>Run agents with their permission checks off.</h1>
    <p class="hero-sub">
      Ouijit's sandbox holds the agent to its task's worktree. The kernel enforces it, and the rest of your
      machine is out of reach.
    </p>
    <DownloadButtons />
    <p class="hero-fine-print">Free and open source. No account, no sign-in, no telemetry.</p>
  </section>

  <div class="feature-hero-visual">
    <div class="plan-desk desk-wash">
      <div class="desk-wash-field" aria-hidden="true" style="--wash: var(--wash-iris)"><span class="desk-wash-grain"></span></div>
      <div class="relative"><SandboxMock kind="hero" client:visible /></div>
    </div>
  </div>

  <section class="feature-section">
    <h2>Turn it on</h2>
    <div class="steps">
      <div class="step">
        <p>
          Set the project's default to Sandbox in <strong>Project Settings</strong>, or set it on the start hook
          alone. Then let the hook skip the prompts.
        </p>
        <pre><code>claude --dangerously-skip-permissions "$OUIJIT_TASK_DESCRIPTION"</code></pre>
      </div>
      <div class="step">
        <p>Or sandbox one command and leave the rest of the line on the host.</p>
        <pre><code>git pull origin main &amp;&amp; ouijit sandbox -- claude --dangerously-skip-permissions "$OUIJIT_TASK_DESCRIPTION"</code></pre>
      </div>
    </div>
  </section>

  <section class="feature-section">
    <div class="feature-rows">
      {features.map((f) => (
        <div class="feature-row">
          <div class="feature-copy">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
          <div class="feature-visual">
            <div class="plan-desk desk-wash desk-wash--graphite">
              <div class="desk-wash-field" aria-hidden="true"><span class="desk-wash-grain"></span></div>
              <div class="relative"><SandboxMock kind={f.mock} client:visible /></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="feature-section">
    <h2>How it works</h2>
    <div class="points">
      {points.map(([title, body]) => (
        <p><strong>{title}</strong>{body}</p>
      ))}
    </div>
  </section>

  <section class="feature-section feature-faq">
    <h2>Questions</h2>
    {faqs.map(([q, a]) => (
      <section class="faq-item">
        <h3>{q}</h3>
        <p>{a}</p>
      </section>
    ))}
  </section>

  <Cta />
</Site>
