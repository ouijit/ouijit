---
import Site from '../../layouts/Site.astro';
import {
  VariantTimeline,
  VariantFleet,
  VariantStreams,
  VariantWall,
} from '../../components/demo/BuildFleetLab.tsx';
---
<Site title="Lab · Build in parallel" noindex>
  <section class="home-build">
    <h1 class="plan-v-headline">Build in parallel — concepts</h1>
    <p style="color: #86868b; max-width: 62ch; margin: 16px 0 0;">
      Scroll-scrubbed stages. The first three show the work rather than the window — when sessions overlap,
      how many are running, and what they emit — so none of them depend on repeating the same mock chrome.
    </p>
  </section>

  <section class="home-build" style="padding-bottom: 0;">
    <h2 class="plan-v-headline">8a · Timeline</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 0;">
      One lane per task over a shared clock. Lanes accumulate as you scroll and visibly overlap; the hatched
      tail is the branch waiting on a person. Ends on the number that matters — wall clock against agent time.
    </p>
  </section>
  <VariantTimeline client:visible />

  <section class="home-build" style="padding-bottom: 0;">
    <h2 class="plan-v-headline">8c · Fleet</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 0;">
      The app's own status dots, at a scale you read as a field rather than as windows: 1 session to 96.
      Exactly one piece of real UI on the stage — point at any dot to load that session into it.
    </p>
  </section>
  <VariantFleet client:visible />

  <section class="home-build" style="padding-bottom: 0;">
    <h2 class="plan-v-headline">8d · Streams</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 0;">
      One terminal at full size, every session's output through it, each line tagged and coloured by its task.
      The interleaving thickens as agents join, and results come back out of order.
    </p>
  </section>
  <VariantStreams client:visible />

  <section class="home-build" style="padding-bottom: 0;">
    <h2 class="plan-v-headline">7c · Wall</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 0;">
      The camera opens inside the lead terminal and retreats until nine are in frame.
    </p>
  </section>
  <VariantWall client:visible />
</Site>
