---
import Site from '../../layouts/Site.astro';
import { VariantMitosis, VariantDock, VariantWall } from '../../components/demo/BuildFleetLab.tsx';
---
<Site title="Lab · Build in parallel, as a fleet" noindex>
  <section class="home-build">
    <h1 class="plan-v-headline">Build in parallel — fleet concepts</h1>
    <p style="color: #86868b; max-width: 62ch; margin: 16px 0 0;">
      Three scroll-scrubbed stages. Each pins the viewport and grows the fleet with the wheel — no desk, no
      beat row, one caption at a time. Scroll slowly; every frame is scrubbed, not stepped.
    </p>
  </section>

  <section class="home-build" style="padding-bottom: 0;">
    <h2 class="plan-v-headline">7a · Mitosis</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 0;">
      One surface divides. Seams open from nothing and every tile shrinks to make room, so the fleet is the
      first terminal splitting rather than tiles arriving beside it.
    </p>
  </section>
  <VariantMitosis client:visible />

  <section class="home-build" style="padding-bottom: 0;">
    <h2 class="plan-v-headline">7b · Dock</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 0;">
      The lead tile settles from centre into its slot while the rest fly in from off stage and lock to the
      grid around it.
    </p>
  </section>
  <VariantDock client:visible />

  <section class="home-build" style="padding-bottom: 0;">
    <h2 class="plan-v-headline">7c · Wall</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 0;">
      The camera opens inside the lead terminal and retreats until nine are in frame — the fleet as scale
      rather than as steps.
    </p>
  </section>
  <VariantWall client:visible />
</Site>
