---
import Site from '../../layouts/Site.astro';
import { VariantMitosis, VariantBoardFill, VariantPullBack } from '../../components/demo/BuildGridLab.tsx';

const VARIANTS = [
  {
    id: '6a',
    name: 'Mitosis',
    note: 'One tile at full width. Each beat the grid reflows and every tile shrinks to make room — the split is the message.',
  },
  {
    id: '6b',
    name: 'Board fill',
    note: 'Fixed 3-up slots. Tiles land in reading order and never move once placed; the empty slot keeps the headroom visible.',
  },
  {
    id: '6c',
    name: 'Pull back',
    note: 'The camera retreats. One tile fills the frame, then the fleet comes into view around it as the grid scales down.',
  },
];
---
<Site title="Lab · Build in parallel, as a grid" noindex>
  <section class="home-build">
    <h1 class="plan-v-headline">Build in parallel — grid concepts</h1>
    <p style="color: #86868b; max-width: 62ch; margin: 16px 0 0;">
      Three stagings of the same five tiles. Scroll each theater, or click a caption to seek.
    </p>
  </section>

  <section class="home-build">
    <h2 class="plan-v-headline">6a · {VARIANTS[0].name}</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 32px;">{VARIANTS[0].note}</p>
    <VariantMitosis client:visible />
  </section>

  <section class="home-build">
    <h2 class="plan-v-headline">6b · {VARIANTS[1].name}</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 32px;">{VARIANTS[1].note}</p>
    <VariantBoardFill client:visible />
  </section>

  <section class="home-build">
    <h2 class="plan-v-headline">6c · {VARIANTS[2].name}</h2>
    <p style="color: #86868b; max-width: 62ch; margin: 12px 0 32px;">{VARIANTS[2].note}</p>
    <VariantPullBack client:visible />
  </section>
</Site>
