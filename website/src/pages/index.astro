---
import Site from '../layouts/Site.astro';
import DownloadButtons from '../components/home/DownloadButtons.astro';
import AppWindowScene from '../components/demo/AppWindowScene.tsx';
import Harnesses from '../components/home/Harnesses.astro';
import Plan from '../components/home/Plan.astro';
import Build from '../components/home/Build.astro';
import Review from '../components/home/Review.astro';
import Extras from '../components/home/Extras.astro';
import Cta from '../components/home/Cta.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ouijit',
  alternateName: 'Ouijit (Integrated Divination Environment)',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS 13+, Linux (x64)',
  description:
    'Ouijit is a task and terminal manager for running coding agents in parallel. Each task gets its own git worktree and terminal, lifecycle hooks launch your agent CLI with the right context, and a session-aware CLI lets agents drive the board back. Live status, notifications, diff review, and per-terminal sandboxing (a Lima VM or nono\'s kernel-level access limits) are built in.',
  url: 'https://ouijit.com',
  downloadUrl: 'https://github.com/ouijit/ouijit/releases/latest',
  softwareHelp: 'https://ouijit.com/docs/',
  license: 'https://github.com/ouijit/ouijit/blob/main/LICENSE',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Ouijit',
    url: 'https://ouijit.com',
  },
  screenshot: [
    'https://ouijit.com/assets/screenshots/kanban.png',
    'https://ouijit.com/assets/screenshots/markdown.png',
    'https://ouijit.com/assets/screenshots/settings.png',
  ],
  featureList: [
    'Per-task git worktrees with Copy-on-Write cloning',
    'Kanban board with lifecycle hooks',
    'Integrated terminal sessions with card stack UI',
    'Live status indicators for Claude Code, Codex, Pi, and OpenCode',
    'Sandboxed agent terminals via a Lima VM or nono',
    'Session-aware ouijit CLI for driving the app from a shell',
  ],
  sameAs: ['https://github.com/ouijit/ouijit'],
};
---
<Site>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

  <section class="hero">
    <h1 data-reveal>Command coding agents <span class="hero-dim">on your terms.</span></h1>
    <div data-reveal style="--reveal-delay: 180ms">
      <DownloadButtons />
    </div>
    <p class="hero-fine-print" data-reveal style="--reveal-delay: 260ms">Free and open source. No account, no sign-in, no telemetry.</p>
  </section>

  <section class="hero-scene">
    <AppWindowScene client:visible />
  </section>

  <section class="home-pitch b-pitch">
    <p class="b-pitch-text">
      Ouijit is a task and terminal manager for running coding agents in parallel. Each task gets its own git
      worktree and terminal, lifecycle hooks launch your agent with the right context, and a session-aware CLI
      lets agents drive the board back. Live status, notifications, diff review, and per-terminal sandboxing
      are built in.
    </p>
    <a class="home-pitch-link" href="/docs/" data-reveal>Read the docs <span aria-hidden="true">→</span></a>
  </section>

  <Plan />

  <Build />

  <Review />

  <Extras />

  <Harnesses />

  <Cta />

  <script>
    import { initHomeChrome, initPitchIllumination } from '../scripts/homeChrome';
    initHomeChrome();
    initPitchIllumination();
  </script>
</Site>
