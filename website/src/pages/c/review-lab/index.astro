---
import Site from '../../../layouts/Site.astro';
import {
  ReviewVariantInbox,
  ReviewVariantTwoAct,
  ReviewVariantLoopLedger,
  ReviewVariantSplitHero,
} from '../../../components/demo/ReviewLab.tsx';
---
<Site noindex>
  <div class="review-lab">
    <header class="review-lab-head">
      <h1>Review section lab</h1>
      <p>
        Round 2: condensing the two keepers — the note round-trip (1a) and the pull request surface (1b) —
        into one staging. The pull request is now the same task's, reduced to its review essentials: the
        segment, the facts, the staged drafts. 1b kept below for reference.
      </p>
    </header>

    <section class="review-lab-concept" id="r2a">
      <div class="review-lab-tag">2a · Two acts — one pinned stage: the note loop plays out, then the task's pull request takes the front like a promoted card</div>
      <ReviewVariantTwoAct client:visible />
    </section>

    <section class="review-lab-concept" id="r2b">
      <div class="review-lab-tag">2b · Loop + ledger — the round-trip theater as-is, then a static pull request band closes the section</div>
      <ReviewVariantLoopLedger client:visible />
    </section>

    <section class="review-lab-concept" id="r2c">
      <div class="review-lab-tag">2c · Split hero — one screen, no scrub: the noted diff beside the condensed pull request</div>
      <ReviewVariantSplitHero client:visible />
    </section>

    <section class="review-lab-concept" id="r1b">
      <div class="review-lab-tag">1b · Inbox — the pull request surface at full size as the hero, three captions under it</div>
      <ReviewVariantInbox client:visible />
    </section>
  </div>

  <style is:global>
    .review-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 240px;
    }
    .review-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
      max-width: 640px;
    }
    .review-lab-concept {
      margin-top: 160px;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .review-lab-tag {
      font-family: 'Iosevka Extended', 'SF Mono', monospace;
      font-size: 13px;
      color: #86868b;
      margin-bottom: 56px;
    }

    /* 1b: caption row under the hero window */
    .rl-caption-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      margin-top: 40px;
    }
    .rl-caption-row h3 {
      font-size: 17px;
      margin: 0;
    }
    .rl-caption-row p {
      color: #86868b;
      font-size: 14px;
      line-height: 1.5;
      margin: 8px 0 0;
    }

    /* 2a's .beat-row styles ship with marketing.css. */

    /* 2b: pull request ledger band */
    .rl-ledger {
      display: flex;
      gap: 40px;
      margin-top: 56px;
      align-items: center;
    }
    .rl-ledger-card {
      flex: 1;
      min-width: 0;
    }
    .rl-ledger-copy {
      width: 300px;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    .rl-ledger-copy h3 {
      font-size: 19px;
      margin: 0;
    }
    .rl-ledger-copy p {
      color: #86868b;
      font-size: 14px;
      line-height: 1.5;
      margin: 8px 0 0;
    }

  </style>
</Site>
