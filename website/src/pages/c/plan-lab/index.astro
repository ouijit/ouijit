---
import Site from '../../../layouts/Site.astro';
import { VariantAnnotated, VariantCollage, VariantStory } from '../../../components/demo/PlanLab.tsx';
---
<Site noindex>
  <div class="plan-lab">
    <header class="plan-lab-head">
      <h1>Plan section lab</h1>
      <p>Three full section mockups: framing + motion together, headline in place. Scroll through at your own pace.</p>
    </header>

    <section class="plan-lab-concept" id="annotated">
      <div class="plan-lab-tag">1 · Annotated diorama — captions on each panel, plays once when it scrolls into view</div>
      <VariantAnnotated client:visible />
    </section>

    <section class="plan-lab-concept" id="collage">
      <div class="plan-lab-tag">2 · Copy beside a collage — overlapping panels, loops forever</div>
      <VariantCollage client:visible />
    </section>

    <section class="plan-lab-concept" id="story">
      <div class="plan-lab-tag">3 · Story rows — each row lands its card as you reach it; the column rides along, sticky</div>
      <VariantStory client:visible />
    </section>
  </div>

  <style is:global>
    .plan-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 200px;
    }
    .plan-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
    }
    .plan-lab-concept {
      margin-top: 140px;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .plan-lab-tag {
      font-family: 'Iosevka Extended', 'SF Mono', monospace;
      font-size: 13px;
      color: #86868b;
      margin-bottom: 56px;
    }

    /* Shared marketing framing */
    .plan-v-headline {
      font-size: 44px;
      text-align: center;
      margin: 0;
    }
    .plan-v-sub {
      color: #86868b;
      font-size: 17px;
      text-align: center;
      max-width: 560px;
      margin: 14px auto 0;
      line-height: 1.5;
    }

    /* V1: figure captions */
    .plan-v1-fig {
      display: flex;
      flex-direction: column;
      min-width: 0;
      margin: 0;
    }
    .plan-v1-fig > figcaption {
      color: #86868b;
      font-size: 14px;
      padding: 0 2px 10px;
    }

    /* V2: source list beside the collage */
    .plan-v2-list {
      list-style: none;
      margin: 28px 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .plan-v2-list li {
      display: flex;
      align-items: center;
      gap: 12px;
      color: #d5d5d7;
      font-size: 15px;
    }
    .plan-v2-list li svg {
      width: 17px;
      height: 17px;
      opacity: 0.55;
      flex-shrink: 0;
    }

    /* V3: story rows */
    .plan-v3-row {
      display: flex;
      align-items: center;
      gap: 40px;
    }
    .plan-v3-copy {
      width: 240px;
      flex-shrink: 0;
    }
    .plan-v3-copy h3 {
      font-size: 21px;
      margin: 0;
    }
    .plan-v3-copy p {
      color: #86868b;
      font-size: 15px;
      line-height: 1.5;
      margin: 10px 0 0;
    }
    .plan-v3-mock {
      flex: 1;
      min-width: 0;
    }

    /* Choreography */
    .plan-lab-card-in {
      animation: plan-lab-card-in 320ms ease-out;
    }
    @keyframes plan-lab-card-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .plan-lab-clearing {
      opacity: 0;
      transition: opacity 350ms ease-out;
    }
    .plan-lab-firing {
      box-shadow:
        var(--shadow-panel),
        0 0 0 1px color-mix(in srgb, var(--color-accent) 55%, transparent),
        0 0 24px color-mix(in srgb, var(--color-accent) 18%, transparent) !important;
      transition: box-shadow 300ms ease-out;
    }
  </style>
</Site>
