---
import Site from '../../../layouts/Site.astro';
import {
  VariantStoryDesk,
  VariantStoryWell,
  VariantStoryOneDesk,
  VariantScrubTether,
  VariantScrubHandoff,
  VariantScrubHue,
} from '../../../components/demo/PlanLab.tsx';
---
<Site noindex>
  <div class="plan-lab">
    <header class="plan-lab-head">
      <h1>Plan section lab</h1>
      <p>Round 4: scroll-scrubbed landings — every animation reverses when you scroll back up.</p>
    </header>

    <section class="plan-lab-concept" id="v4a">
      <div class="plan-lab-tag">4a · Tether — a beam draws from the action to the card as you scroll, on one shared desktop</div>
      <VariantScrubTether client:visible />
    </section>

    <section class="plan-lab-concept" id="v4b">
      <div class="plan-lab-tag">4b · Handoff — the created card lifts out of the source and flies into the column, scrubbed by scroll</div>
      <VariantScrubHandoff client:visible />
    </section>

    <section class="plan-lab-concept" id="v4c">
      <div class="plan-lab-tag">4c · Color pairing — each source's hue rings the mock and edges its card; the count ticks up</div>
      <VariantScrubHue client:visible />
    </section>

    <section class="plan-lab-concept" id="v3d">
      <div class="plan-lab-tag">3d · Desktop cards — each mock on its own wallpaper backdrop, hue per row</div>
      <VariantStoryDesk client:visible />
    </section>

    <section class="plan-lab-concept" id="v3e">
      <div class="plan-lab-tag">3e · Inset wells — recessed containers, mocks cropped at the edge</div>
      <VariantStoryWell client:visible />
    </section>

    <section class="plan-lab-concept" id="v3f">
      <div class="plan-lab-tag">3f · One shared desktop — the whole stage on a single wallpaper container</div>
      <VariantStoryOneDesk client:visible />
    </section>
  </div>

  <style is:global>
    .plan-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 200px;
    }
    .plan-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
    }
    .plan-lab-concept {
      margin-top: 160px;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .plan-lab-tag {
      font-family: 'Iosevka Extended', 'SF Mono', monospace;
      font-size: 13px;
      color: #86868b;
      margin-bottom: 56px;
    }

    /* Shared marketing framing */
    .plan-v-headline {
      font-size: 44px;
      text-align: center;
      margin: 0;
    }
    .plan-v-sub {
      color: #86868b;
      font-size: 17px;
      text-align: center;
      max-width: 560px;
      margin: 14px auto 0;
      line-height: 1.5;
    }

    /* Story rows */
    .plan-v3-row {
      display: flex;
      align-items: center;
      gap: 40px;
    }
    .plan-v3-copy {
      width: 240px;
      flex-shrink: 0;
    }
    .plan-v3-copy h3 {
      font-size: 21px;
      margin: 0;
    }
    .plan-v3-copy p {
      color: #86868b;
      font-size: 15px;
      line-height: 1.5;
      margin: 10px 0 0;
    }
    .plan-v3-mock {
      flex: 1;
      min-width: 0;
    }

    /* Containers separate from the surfaces */
    .plan-desk {
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.07);
      padding: 40px;
      /* clip, not hidden: hidden makes the desk a scroll container, which
         pins the shared-desktop variant's sticky column in place. */
      overflow: clip;
      position: relative;
    }
    .plan-desk > .glass-bevel {
      box-shadow:
        var(--shadow-panel),
        0 32px 64px -32px rgba(0, 0, 0, 0.75);
    }
    .plan-well {
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      background: color-mix(in srgb, var(--color-ink) 4%, transparent);
      box-shadow: inset 0 1px 0 rgba(0, 0, 0, 0.4);
      padding: 36px;
      overflow: hidden;
      position: relative;
    }
    /* Scrubbed card slots: height opens via the 0fr→1fr grid trick so the
       transition reverses cleanly when scroll direction flips. */
    .plan-slot {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 340ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .plan-slot > div {
      position: relative;
      overflow: hidden;
      min-height: 0;
      opacity: 0;
      transform: translateY(-6px);
      transition: opacity 300ms ease, transform 300ms ease;
    }
    .plan-slot-open {
      grid-template-rows: 1fr;
    }
    .plan-slot-in > div {
      opacity: 1;
      transform: none;
    }

    /* Choreography */
    .plan-lab-card-in {
      animation: plan-lab-card-in 320ms ease-out;
    }
    @keyframes plan-lab-card-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .plan-lab-clearing {
      opacity: 0;
      transition: opacity 350ms ease-out;
    }
    .plan-lab-firing {
      box-shadow:
        var(--shadow-panel),
        0 0 0 1px color-mix(in srgb, var(--plan-fire, var(--color-accent)) 55%, transparent),
        0 0 24px color-mix(in srgb, var(--plan-fire, var(--color-accent)) 18%, transparent) !important;
      transition: box-shadow 300ms ease-out;
    }
  </style>
</Site>
