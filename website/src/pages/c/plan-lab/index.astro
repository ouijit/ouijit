---
import Site from '../../../layouts/Site.astro';
import {
  VariantAnnotated,
  VariantAnnotatedStaggered,
  VariantAnnotatedCentered,
  VariantStory,
  VariantStoryCenter,
  VariantStoryLarge,
} from '../../../components/demo/PlanLab.tsx';
---
<Site noindex>
  <div class="plan-lab">
    <header class="plan-lab-head">
      <h1>Plan section lab</h1>
      <p>Riffs on the diorama (1a–1c) and the story rows (3a–3c). All play their cards as you reach them.</p>
    </header>

    <section class="plan-lab-concept" id="v1a">
      <div class="plan-lab-tag">1a · Diorama — captions above, column right</div>
      <VariantAnnotated client:visible />
    </section>

    <section class="plan-lab-concept" id="v1b">
      <div class="plan-lab-tag">1b · Diorama, staggered — offset heights, captions below</div>
      <VariantAnnotatedStaggered client:visible />
    </section>

    <section class="plan-lab-concept" id="v1c">
      <div class="plan-lab-tag">1c · Diorama, board centered — sources flank the column</div>
      <VariantAnnotatedCentered client:visible />
    </section>

    <section class="plan-lab-concept" id="v3a">
      <div class="plan-lab-tag">3a · Story rows — copy beside each mock, column sticky right</div>
      <VariantStory client:visible />
    </section>

    <section class="plan-lab-concept" id="v3b">
      <div class="plan-lab-tag">3b · Story rows, column center — rows land cards from both sides</div>
      <VariantStoryCenter client:visible />
    </section>

    <section class="plan-lab-concept" id="v3c">
      <div class="plan-lab-tag">3c · Story rows, column left — sub-section scale typography</div>
      <VariantStoryLarge client:visible />
    </section>
  </div>

  <style is:global>
    .plan-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 200px;
    }
    .plan-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
    }
    .plan-lab-concept {
      margin-top: 160px;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .plan-lab-tag {
      font-family: 'Iosevka Extended', 'SF Mono', monospace;
      font-size: 13px;
      color: #86868b;
      margin-bottom: 56px;
    }

    /* Shared marketing framing */
    .plan-v-headline {
      font-size: 44px;
      text-align: center;
      margin: 0;
    }
    .plan-v-sub {
      color: #86868b;
      font-size: 17px;
      text-align: center;
      max-width: 560px;
      margin: 14px auto 0;
      line-height: 1.5;
    }

    /* Diorama figure captions */
    .plan-v1-fig {
      display: flex;
      flex-direction: column;
      min-width: 0;
      margin: 0;
    }
    .plan-v1-fig > figcaption {
      color: #86868b;
      font-size: 14px;
      padding: 0 2px 10px;
    }
    .plan-v1-fig.captions-below > figcaption {
      padding: 12px 2px 0;
    }

    /* Story rows */
    .plan-v3-row {
      display: flex;
      align-items: center;
      gap: 40px;
    }
    .plan-v3-copy {
      width: 240px;
      flex-shrink: 0;
    }
    .plan-v3-copy h3 {
      font-size: 21px;
      margin: 0;
    }
    .plan-v3-copy p {
      color: #86868b;
      font-size: 15px;
      line-height: 1.5;
      margin: 10px 0 0;
    }
    .plan-v3-mock {
      flex: 1;
      min-width: 0;
    }
    .plan-v3-stacked {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .plan-v3c .plan-v3-copy h3 {
      font-size: 30px;
    }
    .plan-v3c .plan-v3-copy p {
      font-size: 16px;
      max-width: 480px;
    }

    /* Choreography */
    .plan-lab-card-in {
      animation: plan-lab-card-in 320ms ease-out;
    }
    @keyframes plan-lab-card-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .plan-lab-clearing {
      opacity: 0;
      transition: opacity 350ms ease-out;
    }
    .plan-lab-firing {
      box-shadow:
        var(--shadow-panel),
        0 0 0 1px color-mix(in srgb, var(--color-accent) 55%, transparent),
        0 0 24px color-mix(in srgb, var(--color-accent) 18%, transparent) !important;
      transition: box-shadow 300ms ease-out;
    }
  </style>
</Site>
