---
import Site from '../../../layouts/Site.astro';
import { ArrangeMosaic, ArrangeFlanked, ArrangeSeamed } from '../../../components/demo/PlanLab.tsx';
---
<Site noindex>
  <div class="plan-lab">
    <header class="plan-lab-head">
      <h1>Plan section lab</h1>
      <p>
        Everything on stage at once — no tabs. Cards land in the column on a staggered choreography;
        the firing source glows while its card arrives. Reload to replay.
      </p>
    </header>

    <section class="plan-lab-concept" id="mosaic">
      <h2>A · Mosaic</h2>
      <p>Terminal tall on the left, issues and plan stacked beside it, column on the right.</p>
      <ArrangeMosaic client:visible />
    </section>

    <section class="plan-lab-concept" id="flanked">
      <h2>B · Flanked</h2>
      <p>The column dead-center; terminal and issues left, the plan right.</p>
      <ArrangeFlanked client:visible />
    </section>

    <section class="plan-lab-concept" id="seamed">
      <h2>C · One seamed panel</h2>
      <p>A single panel split by pane seams, the way the app splits terminals — column as the last pane.</p>
      <ArrangeSeamed client:visible />
    </section>
  </div>

  <style is:global>
    .plan-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 160px;
    }
    .plan-lab-head p,
    .plan-lab-concept > p {
      color: #86868b;
      margin: 8px 0 0;
    }
    .plan-lab-concept {
      margin-top: 96px;
    }
    .plan-lab-concept > h2 {
      font-size: 24px;
    }
    .plan-lab-concept > p {
      margin-bottom: 28px;
    }
    .plan-lab-card-in {
      animation: plan-lab-card-in 320ms ease-out;
    }
    @keyframes plan-lab-card-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    .plan-lab-firing {
      box-shadow:
        var(--shadow-panel),
        0 0 0 1px color-mix(in srgb, var(--color-accent) 55%, transparent),
        0 0 24px color-mix(in srgb, var(--color-accent) 18%, transparent) !important;
      transition: box-shadow 300ms ease-out;
    }
    .plan-lab-firing-flat {
      background: color-mix(in srgb, var(--color-accent) 5%, transparent);
      transition: background 300ms ease-out;
    }
  </style>
</Site>
