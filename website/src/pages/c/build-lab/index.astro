---
import Site from '../../../layouts/Site.astro';
import { VariantDeep, VariantStrip, VariantCharged } from '../../../components/demo/BuildLab.tsx';
---
<Site noindex>
  <div class="build-lab">
    <header class="build-lab-head">
      <h1>Build section lab</h1>
      <p>Round 3: the Workbench developed. Three candidates — how much of the pillar the one stack carries.</p>
    </header>

    <section class="build-lab-concept" id="v3a">
      <div class="build-lab-tag">3a · Deep workbench — five beats on one stack: start hook, plan.md, dev-terminal promotion with the preview, the agent's CLI handoff, statuses</div>
      <VariantDeep client:visible />
    </section>

    <section class="build-lab-concept" id="v3b">
      <div class="build-lab-tag">3b · Workbench + strip — the tight four-beat stack, with sandbox / hooks / CLI as a strip below</div>
      <VariantStrip client:visible />
    </section>

    <section class="build-lab-concept" id="v3c">
      <div class="build-lab-tag">3c · Charged workbench — same four beats, on a graphite desk that gains a hue per beat (the Plan section's color language)</div>
      <VariantCharged client:visible />
    </section>
  </div>

  <style is:global>
    .build-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 240px;
    }
    .build-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
    }
    .build-lab-concept {
      margin-top: 160px;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .build-lab-tag {
      font-family: 'Iosevka Extended', 'SF Mono', monospace;
      font-size: 13px;
      color: #86868b;
      margin-bottom: 56px;
    }

    .bl-split {
      display: flex;
      gap: 48px;
      align-items: flex-start;
    }
    .bl-steps {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 260px;
      padding: 16vh 0 30vh;
    }
    .bl-step h3 {
      font-size: 21px;
      margin: 0;
    }
    .bl-step p {
      color: #86868b;
      font-size: 15px;
      line-height: 1.5;
      margin: 10px 0 0;
    }
    .bl-rail {
      position: sticky;
      top: 90px;
      flex-shrink: 0;
    }

    .bl-strip {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 24px;
      margin-top: 72px;
    }
    .bl-strip-cell {
      border-radius: 24px;
      padding: 24px;
      background:
        radial-gradient(120% 140% at 50% 0%, rgba(255, 255, 255, 0.05), transparent 60%),
        linear-gradient(180deg, #1c1d23, #131318);
      position: relative;
    }
    .bl-strip-cell::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      border: 1px solid rgba(255, 255, 255, 0.07);
      pointer-events: none;
    }
    .bl-strip-cell h4 {
      font-size: 16px;
      margin: 0 0 4px;
    }
    .bl-strip-cell p {
      color: #86868b;
      font-size: 13px;
      line-height: 1.5;
      margin: 0 0 16px;
    }
  </style>
</Site>
