---
import Site from '../../../layouts/Site.astro';
import { BuildSectionCandidate } from '../../../components/demo/BuildLab.tsx';
---
<Site noindex>
  <div class="build-lab">
    <header class="build-lab-head">
      <h1>Build section lab</h1>
      <p>Round 4: the 3b direction as a full section — headline, four-beat workbench with the dev-terminal promotion, and the strip.</p>
    </header>

    <section class="build-lab-concept" id="v4">
      <BuildSectionCandidate client:visible />
    </section>
  </div>

  <style is:global>
    .build-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 240px;
    }
    .build-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
    }
    .build-lab-concept {
      margin-top: 120px;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .bl-standfirst {
      color: #86868b;
      font-size: 17px;
      line-height: 1.5;
      margin: 14px 0 0;
      max-width: 560px;
    }

    .bl-split {
      display: flex;
      gap: 48px;
      align-items: flex-start;
      margin-top: 24px;
    }
    .bl-steps {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 260px;
      padding: 14vh 0 26vh;
    }
    .bl-step h3 {
      font-size: 21px;
      margin: 0;
    }
    .bl-step p {
      color: #86868b;
      font-size: 15px;
      line-height: 1.5;
      margin: 10px 0 0;
    }
    .bl-rail {
      position: sticky;
      top: 90px;
      flex-shrink: 0;
    }

    .bl-strip {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 24px;
      margin-top: 48px;
      align-items: start;
    }
    .bl-strip-cell {
      border-radius: 24px;
      padding: 24px;
      overflow: clip;
      background:
        radial-gradient(120% 140% at 50% 0%, rgba(255, 255, 255, 0.05), transparent 60%),
        linear-gradient(180deg, #1c1d23, #131318);
      position: relative;
    }
    .bl-strip-cell::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      border: 1px solid rgba(255, 255, 255, 0.07);
      pointer-events: none;
    }
    .bl-strip-cell h4 {
      font-size: 16px;
      margin: 0 0 4px;
    }
    .bl-strip-cell p {
      color: #86868b;
      font-size: 13px;
      line-height: 1.5;
      margin: 0 0 16px;
    }
  </style>
</Site>
