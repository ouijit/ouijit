---
import Site from '../../../layouts/Site.astro';
import { VariantTheater, VariantFloat, VariantReference } from '../../../components/demo/BuildLab.tsx';
---
<Site noindex>
  <div class="build-lab">
    <header class="build-lab-head">
      <h1>Build section lab</h1>
      <p>Round 5: same workbench, different stagings — looking for a shape the Plan section doesn't already own. The strip is unchanged and omitted here.</p>
    </header>

    <section class="build-lab-concept" id="v5a">
      <div class="build-lab-tag">5a · Theater — full-width centered stage pinned to the viewport; one caption at a time below it</div>
      <VariantTheater client:visible />
    </section>

    <section class="build-lab-concept" id="v5b">
      <div class="build-lab-tag">5b · Float — no desk at all: the stack loose on the page with an ambient glow, copy at the side</div>
      <VariantFloat client:visible />
    </section>

    <section class="build-lab-concept" id="v5ref">
      <div class="build-lab-tag">Reference · round 4's staging — side copy on a sticky desk (the Plan silhouette)</div>
      <VariantReference client:visible />
    </section>
  </div>

  <style is:global>
    .build-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 240px;
    }
    .build-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
    }
    .build-lab-concept {
      margin-top: 160px;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }
    .build-lab-tag {
      font-family: 'Iosevka Extended', 'SF Mono', monospace;
      font-size: 13px;
      color: #86868b;
      margin-bottom: 56px;
    }

    /* Side-copy layout (5b, reference) */
    .bl-split {
      display: flex;
      gap: 48px;
      align-items: flex-start;
    }
    .bl-steps {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 260px;
      padding: 14vh 0 26vh;
    }
    .bl-step h3 {
      font-size: 21px;
      margin: 0;
    }
    .bl-step p {
      color: #86868b;
      font-size: 15px;
      line-height: 1.5;
      margin: 10px 0 0;
    }
    .bl-rail {
      position: sticky;
      top: 90px;
      flex-shrink: 0;
    }

    /* Theater (5a, 5c) */
    .bl-theater-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 40px;
    }
    .bl-theater-captions {
      position: relative;
      width: 620px;
      height: 92px;
      text-align: center;
    }
    .bl-theater-cap {
      position: absolute;
      inset: 0;
      transition: opacity 260ms ease;
    }
    .bl-theater-cap h3 {
      font-size: 21px;
      margin: 0;
    }
    .bl-theater-cap p {
      color: #86868b;
      font-size: 15px;
      line-height: 1.5;
      margin: 8px 0 0;
    }

    /* Float (5b) */
    .bl-float-glow {
      position: absolute;
      inset: -120px -100px -80px;
      background: radial-gradient(55% 55% at 50% 42%, rgba(99, 102, 241, 0.17), transparent 72%);
      pointer-events: none;
    }
  </style>
</Site>
