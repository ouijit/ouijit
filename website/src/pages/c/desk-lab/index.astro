---
import Site from '../../../layouts/Site.astro';
import { SampleCard } from '../../../components/demo/DeskLab.tsx';
import stars from '../../../components/demo/desk-art/stars.svg?raw';
import flow from '../../../components/demo/desk-art/flow.svg?raw';
import topo from '../../../components/demo/desk-art/topo.svg?raw';
---
<Site noindex>
  <div class="desk-lab">
    <header class="desk-lab-head">
      <h1>Desk background lab</h1>
      <p>
        Round 5: generative and organic — a plotted star chart, a computed flow field, surveyed contours,
        marbled ink, and aurora with real structure. All prior rounds retired.
      </p>
    </header>

    <section class="desk-lab-concept" id="du">
      <div class="desk-lab-tag">u · Star chart — a deep field with a faint galactic band, two plotted constellations, one flagged star</div>
      <div class="plan-desk dl dl-u">
        <div class="dl-layer" set:html={stars} />
        <SampleCard client:visible />
      </div>
    </section>

    <section class="desk-lab-concept" id="dv">
      <div class="desk-lab-tag">v · Flow field — 150 computed streamlines following a noise field, a few carrying the accent</div>
      <div class="plan-desk dl dl-v">
        <div class="dl-layer" set:html={flow} />
        <SampleCard client:visible />
      </div>
    </section>

    <section class="desk-lab-concept" id="dw">
      <div class="desk-lab-tag">w · Topography — surveyed contour lines around a peak just off the card's corner, index lines heavier, one accent contour</div>
      <div class="plan-desk dl dl-w">
        <div class="dl-layer" set:html={topo} />
        <SampleCard client:visible />
      </div>
    </section>

    <section class="desk-lab-concept" id="dx">
      <div class="desk-lab-tag">x · Marbled ink — straight strata displaced by fluid turbulence; three strands carry color</div>
      <div class="plan-desk dl dl-x">
        <svg class="dl-layer" viewBox="0 0 1200 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <filter id="marbleF" x="-20%" y="-20%" width="140%" height="140%">
              <feTurbulence type="fractalNoise" baseFrequency="0.011 0.042" numOctaves="3" seed="11" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="110" xChannelSelector="R" yChannelSelector="G" />
            </filter>
          </defs>
          <g filter="url(#marbleF)">
            {Array.from({ length: 44 }, (_, i) => {
              const y = -40 + i * 15;
              const accent = i === 12 ? '#6366f1' : i === 25 ? '#da77f2' : i === 33 ? '#22d3ee' : null;
              const stroke = accent ?? 'rgba(255,255,255,0.09)';
              const width = accent ? 1.6 : 1;
              const opacity = accent ? 0.55 : 1;
              return <path d={`M-60,${y} H1260`} fill="none" stroke={stroke} stroke-width={width} opacity={opacity} />;
            })}
          </g>
        </svg>
        <SampleCard client:visible />
      </div>
    </section>

    <section class="desk-lab-concept" id="dy">
      <div class="desk-lab-tag">y · Aurora — curtains with real vertical structure, displaced and blurred, over a sparse star field</div>
      <div class="plan-desk dl dl-y">
        <svg class="dl-layer" viewBox="0 0 1200 560" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <filter id="aurF" x="-30%" y="-30%" width="160%" height="160%">
              <feTurbulence type="fractalNoise" baseFrequency="0.004 0.028" numOctaves="2" seed="5" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="170" xChannelSelector="R" yChannelSelector="G" result="d" />
              <feGaussianBlur in="d" stdDeviation="7 14" />
            </filter>
          </defs>
          <g>
            <circle cx="140" cy="80" r="1" fill="rgba(255,255,255,0.5)" />
            <circle cx="360" cy="46" r="1.4" fill="rgba(255,255,255,0.4)" />
            <circle cx="700" cy="70" r="1" fill="rgba(255,255,255,0.45)" />
            <circle cx="1080" cy="52" r="1.2" fill="rgba(255,255,255,0.5)" />
            <circle cx="920" cy="120" r="0.9" fill="rgba(255,255,255,0.35)" />
            <circle cx="240" cy="500" r="1.1" fill="rgba(255,255,255,0.35)" />
            <circle cx="1130" cy="480" r="1" fill="rgba(255,255,255,0.4)" />
          </g>
          <g filter="url(#aurF)" transform="skewX(-8)">
            <rect x="180" y="-80" width="70" height="720" fill="rgba(63,185,80,0.20)" />
            <rect x="290" y="-80" width="40" height="720" fill="rgba(34,211,238,0.14)" />
            <rect x="620" y="-80" width="90" height="720" fill="rgba(63,185,80,0.13)" />
            <rect x="760" y="-80" width="46" height="720" fill="rgba(218,119,242,0.12)" />
            <rect x="1010" y="-80" width="70" height="720" fill="rgba(34,211,238,0.16)" />
          </g>
        </svg>
        <SampleCard client:visible />
      </div>
    </section>
  </div>

  <style is:global>
    .desk-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 240px;
    }
    .desk-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
      max-width: 640px;
    }
    .desk-lab-concept {
      margin-top: 120px;
    }
    .desk-lab-tag {
      font-family: 'Iosevka Extended', 'SF Mono', monospace;
      font-size: 13px;
      color: #86868b;
      margin-bottom: 32px;
    }

    .dl {
      padding: 80px 64px;
    }
    .dl-layer {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .dl-layer svg,
    svg.dl-layer {
      width: 100%;
      height: 100%;
      display: block;
    }

    .dl-u {
      background: #07070c;
    }
    .dl-v {
      background: #0b0b10;
    }
    .dl-w {
      background: #0d0d11;
    }
    .dl-x {
      background: #0a0a0e;
    }
    .dl-y {
      background: #060809;
    }
  </style>
</Site>
