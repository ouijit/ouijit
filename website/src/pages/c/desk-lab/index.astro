---
import Site from '../../../layouts/Site.astro';
import { SampleCard } from '../../../components/demo/DeskLab.tsx';
---
<Site noindex>
  <div class="desk-lab">
    <header class="desk-lab-head">
      <h1>Desk background lab</h1>
      <p>
        Round 6: rich, vibrant color — solid fields, gradient transitions, and grain layered together. No
        line work anywhere. All prior rounds retired.
      </p>
    </header>

    <section class="desk-lab-concept" id="r6a">
      <div class="desk-lab-tag">A · Rothko veil — two luminous solid fields, indigo over magenta, breathing through a wide soft boundary under heavy grain</div>
      <div class="plan-desk dl dl-ra">
        <div class="dl-layer dl-ra-glow" aria-hidden="true"></div>
        <div class="dl-layer dl-grain" aria-hidden="true"></div>
        <div class="dl-layer dl-grain--coarse" aria-hidden="true"></div>
        <SampleCard client:visible />
      </div>
    </section>

    <section class="desk-lab-concept" id="r6b">
      <div class="desk-lab-tag">B · Sunset stack — banded color climbing from deep indigo to ember, each band solid at its heart, blended at its edges</div>
      <div class="plan-desk dl dl-rb">
        <div class="dl-layer dl-grain" aria-hidden="true"></div>
        <SampleCard client:visible />
      </div>
    </section>

    <section class="desk-lab-concept" id="r6c">
      <div class="desk-lab-tag">C · Airbrush — saturated cyan and magenta sprayed into a vivid indigo ground, dense spray grain on top</div>
      <div class="plan-desk dl dl-rc">
        <div class="dl-layer dl-rc-spray" aria-hidden="true"></div>
        <div class="dl-layer dl-grain" aria-hidden="true"></div>
        <div class="dl-layer dl-grain--coarse" aria-hidden="true"></div>
        <SampleCard client:visible />
      </div>
    </section>

    <section class="desk-lab-concept" id="r6d">
      <div class="desk-lab-tag">D · Holographic foil — molten conic color, blurred and oversaturated, with one specular sweep and grain: liquid vinyl</div>
      <div class="plan-desk dl dl-rd">
        <div class="dl-layer dl-layer--bleed dl-rd-foil" aria-hidden="true"></div>
        <div class="dl-layer dl-rd-sheen" aria-hidden="true"></div>
        <div class="dl-layer dl-grain" aria-hidden="true"></div>
        <SampleCard client:visible />
      </div>
    </section>

    <section class="desk-lab-concept" id="r6e">
      <div class="desk-lab-tag">E · Halftone dither — a hot magenta-to-indigo sweep whose midtones break into print dots; ink texture, not light</div>
      <div class="plan-desk dl dl-re">
        <div class="dl-layer dl-re-dots" aria-hidden="true"></div>
        <div class="dl-layer dl-re-dots--light" aria-hidden="true"></div>
        <div class="dl-layer dl-grain" aria-hidden="true"></div>
        <SampleCard client:visible />
      </div>
    </section>
  </div>

  <style is:global>
    .desk-lab {
      max-width: 1200px;
      margin: 0 auto;
      padding: 64px var(--content-padding) 240px;
    }
    .desk-lab-head p {
      color: #86868b;
      margin: 8px 0 0;
      max-width: 640px;
    }
    .desk-lab-concept {
      margin-top: 120px;
    }
    .desk-lab-tag {
      font-family: 'Iosevka Extended', 'SF Mono', monospace;
      font-size: 13px;
      color: #86868b;
      margin-bottom: 32px;
    }

    .dl {
      padding: 80px 64px;
    }
    .dl-layer {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .dl-layer--bleed {
      inset: -90px;
    }

    /* Shared grain: fine film grain and a coarser spray, blended into the color. */
    .dl-grain {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
      opacity: 0.34;
      mix-blend-mode: overlay;
    }
    .dl-grain--coarse {
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='260'><filter id='m'><feTurbulence type='fractalNoise' baseFrequency='0.32' numOctaves='3' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23m)'/></svg>");
      opacity: 0.22;
      mix-blend-mode: soft-light;
    }

    /* A · Rothko veil */
    .dl-ra {
      background: linear-gradient(
        180deg,
        #4f46e5 0%,
        #4f46e5 34%,
        #7c3aed 50%,
        #a21caf 66%,
        #9d174d 100%
      );
    }
    .dl-ra-glow {
      background:
        radial-gradient(130% 55% at 50% -6%, rgba(165, 180, 252, 0.6), transparent 62%),
        radial-gradient(130% 50% at 50% 106%, rgba(244, 114, 182, 0.5), transparent 62%);
      mix-blend-mode: screen;
    }

    /* B · Sunset stack */
    .dl-rb {
      background: linear-gradient(
        180deg,
        #221d6e 0%,
        #372f9e 16%,
        #5b2bc9 30%,
        #8b2fd0 44%,
        #c02aae 58%,
        #e2447a 72%,
        #f56b4e 86%,
        #f99347 100%
      );
    }

    /* C · Airbrush */
    .dl-rc {
      background: #2b21a8;
    }
    .dl-rc-spray {
      background:
        radial-gradient(58% 72% at 6% 8%, rgba(34, 211, 238, 0.9), transparent 64%),
        radial-gradient(64% 80% at 96% 90%, rgba(232, 121, 249, 0.85), transparent 64%),
        radial-gradient(42% 52% at 84% 4%, rgba(250, 204, 21, 0.32), transparent 60%),
        radial-gradient(46% 60% at 12% 96%, rgba(99, 102, 241, 0.8), transparent 62%);
    }

    /* D · Holographic foil */
    .dl-rd {
      background: #170f2a;
    }
    .dl-rd-foil {
      background: conic-gradient(
        from 215deg at 62% 38%,
        #e879f9,
        #f59e0b,
        #22d3ee,
        #6366f1,
        #ec4899,
        #e879f9
      );
      filter: blur(52px) saturate(1.55);
    }
    .dl-rd-sheen {
      background: linear-gradient(112deg, transparent 38%, rgba(255, 255, 255, 0.22) 50%, transparent 62%);
      mix-blend-mode: screen;
    }

    /* E · Halftone dither */
    .dl-re {
      background: linear-gradient(115deg, #ec1e8c 0%, #a02ad4 42%, #5b2bc9 68%, #2a2380 100%);
    }
    .dl-re-dots {
      background-image: radial-gradient(circle, rgba(24, 12, 60, 0.6) 0 2.1px, transparent 2.7px);
      background-size: 9px 9px;
      -webkit-mask: linear-gradient(115deg, transparent 26%, #000 52%);
      mask: linear-gradient(115deg, transparent 26%, #000 52%);
    }
    .dl-re-dots--light {
      background-image: radial-gradient(circle, rgba(255, 214, 240, 0.5) 0 1.7px, transparent 2.2px);
      background-size: 11px 11px;
      background-position: 4px 5px;
      -webkit-mask: linear-gradient(115deg, #000 18%, transparent 46%);
      mask: linear-gradient(115deg, #000 18%, transparent 46%);
    }
  </style>
</Site>
