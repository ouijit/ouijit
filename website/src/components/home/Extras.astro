---
import {
  PaletteMock,
  SandboxMock,
  ScriptsMock,
  HooksMock,
  ThemeMock,
  TagsMock,
  ShortcutsMock,
  ResumeMock,
  CliMock,
} from '../demo/ExtrasMocks';

/**
 * Two ribbons of cards, wider than the window and drifting together. `w` sets
 * a card's slot; its height is whatever its copy and mock come to, and the
 * differences between them are what give the band its outer contour. The rows
 * meet on the seam and grow away from it, so a shorter card takes its height
 * off the outside rather than opening a gap in the middle.
 *
 * The seam between the rows is broken by `shift`, which moves a card and the
 * one across from it together, gutter intact. That only works while the two
 * stay in register, so the rows are built to the same run width — the check
 * below fails the build if an edit breaks it — and the last three cards of
 * each row are matched in width to give the shifts a column to move in. The
 * bottom row opens with one card as wide as the top row's first two, which is
 * what buys those columns out of four cards against five.
 */
const TOP = [
  {
    id: 'palette',
    shift: 0,
    w: 540,
    title: 'Everything is three keystrokes away.',
    body: '⌘K searches terminals, projects, tasks, and pull requests, ranked by how often you come back to them.',
    Mock: PaletteMock,
  },
  {
    id: 'sandbox',
    shift: 0,
    w: 470,
    title: 'Untrusted code, contained.',
    body: "Agents run in a Lima VM that mounts only the task's worktree — or sandboxed in place with Seatbelt and Landlock, via nono.",
    Mock: SandboxMock,
  },
  {
    id: 'shortcuts',
    shift: 26,
    w: 390,
    title: 'No pointer required.',
    body: '⌘1 through ⌘9 land on any terminal in the stack; the board, a new task, and a fresh terminal are each one chord away.',
    Mock: ShortcutsMock,
  },
  {
    id: 'scripts',
    shift: -22,
    w: 410,
    title: 'The commands you always run.',
    body: "Dev server, tests, release — save them with the project and run them in any task's worktree.",
    Mock: ScriptsMock,
  },
  {
    id: 'hooks',
    shift: 30,
    w: 430,
    title: 'Hooks for every stage.',
    body: 'Start, continue, run, review, done: each stage runs the command you give it, task context included.',
    Mock: HooksMock,
  },
];

const BOTTOM = [
  {
    id: 'cli',
    shift: 0,
    w: 1028,
    title: 'Your agent can drive all of it.',
    body: 'The <code>ouijit</code> CLI lands in every terminal the app opens — sandboxed ones included, nothing to install. Tasks, tags, hooks, scripts, drafts, themes: everything on this page, as commands with JSON out.',
    Mock: CliMock,
  },
  {
    id: 'theme',
    shift: 26,
    w: 390,
    title: 'Theme every token.',
    body: 'Start from a preset or build your own — dark or light base, every color overridable, down to the ANSI palette.',
    Mock: ThemeMock,
  },
  {
    id: 'tags',
    shift: -22,
    w: 410,
    title: 'Filter by tag.',
    body: 'Tag terminals, then cut the stack to one tag — or group the home view by them.',
    Mock: TagsMock,
  },
  {
    id: 'resume',
    shift: 30,
    w: 430,
    title: 'Quit without losing the room.',
    body: "The next launch brings the session's terminals back in their worktrees, panels included.",
    Mock: ResumeMock,
  },
];

const GAP = 18;
/** Pixels a ribbon travels per second. Both ribbons take it, so they move
 *  together; their differing widths only change how long each takes round. */
const DRIFT_PX_PER_S = 22;
const runWidth = (row: typeof TOP) => row.reduce((sum, c) => sum + c.w + GAP, 0);

if (runWidth(TOP) !== runWidth(BOTTOM)) {
  throw new Error(
    `Power tools rows must be the same width to stay in register: top ${runWidth(TOP)}, bottom ${runWidth(BOTTOM)}`,
  );
}
---

<section class="details-section">
  <div class="details-head">
    <h2 data-reveal>Power tools included</h2>
  </div>
  <div class="tools-flow bento" data-reveal>
    {
      [
        { row: TOP, cls: 'tools-ribbon--top' },
        { row: BOTTOM, cls: 'tools-ribbon--btm' },
      ].map(({ row, cls }) => (
        <div class:list={['tools-ribbon', cls]} style={`--drift: ${(runWidth(row) / DRIFT_PX_PER_S).toFixed(1)}s`}>
          {[0, 1].map((copy) => (
            <div class="tools-run" aria-hidden={copy === 1 ? 'true' : undefined}>
              {row.map((card) => {
                const Mock = card.Mock;
                return (
                  <article
                    class="detail desk-wash desk-wash--graphite"
                    data-tool={card.id}
                    style={`--w: ${card.w}px; --shift: ${card.shift}px`}
                  >
                    <div class="desk-wash-field" aria-hidden="true"><span class="desk-wash-grain" /></div>
                    <div class="desk-wash-field bento-lit-field" aria-hidden="true"><span class="desk-wash-grain" /></div>
                    <div class="detail-title">{card.title}</div>
                    <p set:html={card.body} />
                    <div class="bento-stack" aria-hidden="true"><Mock /></div>
                  </article>
                );
              })}
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>
