---
const year = new Date().getFullYear();

const groups: { title: string; links: [string, string, boolean?][] }[] = [
  {
    title: 'Ouijit',
    links: [
      ['Docs', '/docs/'],
      ['Sandbox', '/sandbox/'],
      ['Changelog', '/changelog/'],
      ['Writing', '/writing/'],
      ['FAQ', '/faq/'],
      ['About', '/about/'],
      ['GitHub', 'https://github.com/ouijit/ouijit', true],
    ],
  },
  {
    title: 'Coming from',
    links: [
      ['Conductor', '/conductor-alternative/'],
      ['Vibe Kanban', '/vibe-kanban-alternative/'],
      ['Claude Squad', '/claude-squad-alternative/'],
      ['Crystal', '/crystal-alternative/'],
      ['Superset', '/superset-alternative/'],
    ],
  },
  {
    title: 'Works with',
    links: [
      ['Claude Code', '/for/claude-code/'],
      ['Codex', '/for/codex/'],
      ['Pi', '/for/pi/'],
      ['OpenCode', '/for/opencode/'],
    ],
  },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-columns">
      {groups.map((g) => (
        <div class="footer-column">
          <div class="footer-heading">{g.title}</div>
          <ul>
            {g.links.map(([label, href, external]) => (
              <li>
                {external ? (
                  <a href={href} target="_blank" rel="noopener">{label}</a>
                ) : (
                  <a href={href}>{label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="footer-legal">&copy; {year} Ouijit. Licensed under AGPL-3.0.</div>
  </div>
</footer>
