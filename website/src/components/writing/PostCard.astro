---
import Cover from './Cover.astro';
import { AUTHOR, postDate, readingMinutes, type Post } from '../../writing';

interface Props {
  post: Post;
}
const { post } = Astro.props;
---
<a class="writing-card" href={`/writing/${post.id}/`}>
  <Cover cover={post.data.cover} />
  <h2>{post.data.title}</h2>
  <p>{post.data.description}</p>
  <div class="writing-meta">
    <span>{AUTHOR.name}</span>
    <time datetime={post.data.date.toISOString()}>{postDate.format(post.data.date)}</time>
    <span>{readingMinutes(post)} min read</span>
  </div>
</a>
