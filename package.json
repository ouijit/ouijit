{
  "name": "ouijit",
  "productName": "ouijit",
  "version": "1.11.0",
  "description": "Discover and manage your local development projects",
  "main": ".vite/build/main.js",
  "bin": {
    "ouijit": "./dist-cli/ouijit.js"
  },
  "scripts": {
    "prestart": "node scripts/build-cli.mjs",
    "start": "electron-forge start",
    "package": "npm run build:cli && electron-forge package",
    "make": "npm run build:cli && electron-forge make",
    "make:linux": "./scripts/build-linux.sh",
    "publish": "npm run build:cli && electron-forge publish",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint src/ && prettier --check src/",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "pretest": "node scripts/sqlite-bindings.mjs node",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/sqlite-bindings.mjs electron",
    "test:e2e": "node e2e/build.mjs && npx playwright test --config e2e/playwright.config.ts",
    "pretest:e2e:ci": "node scripts/sqlite-bindings.mjs electron",
    "test:e2e:ci": "node e2e/build.mjs && xvfb-run npx playwright test --config e2e/playwright.config.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "docs:check": "node scripts/build-cli.mjs && node scripts/docs-check.mjs",
    "pretest:full": "node scripts/sqlite-bindings.mjs",
    "test:full": "vitest run && node e2e/build.mjs && npx playwright test --config e2e/playwright.config.ts",
    "postinstall": "{ [ \"$(uname)\" != Darwin ] || patch-package; } && ./scripts/download-nono.sh && chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "db:reset": "node scripts/dev-db.mjs reset",
    "db:seed": "node scripts/dev-db.mjs seed",
    "db:clone-prod": "node scripts/dev-db.mjs clone-prod",
    "capture": "node scripts/capture/run.mjs",
    "website": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build"
  },
  "keywords": [],
  "author": "pbjer",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.1.2",
    "@floating-ui/react": "^0.27.20",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@xterm/headless": "^6.0.0",
    "electron": "39.8.10",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react-hotkeys-hook": "^5.4.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@linear/sdk": "^94.0.0",
    "@phosphor-icons/core": "^2.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^12.11.1",
    "commander": "^14.0.3",
    "dompurify": "^3.4.17",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "fix-path": "^5.0.0",
    "hotkeys-js": "^4.1.2",
    "koffi": "^2.16.3",
    "launch-editor": "^2.14.2",
    "marked": "^17.0.6",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "tar": "^7.5.7",
    "tmp": "^0.2.5",
    "@xmldom/xmldom": "^0.8.13",
    "lodash": "^4.18.1",
    "fast-uri": "^3.1.2",
    "ip-address": "^10.2.0",
    "make-fetch-happen": "^15.0.5",
    "macos-alias": "npm:@napi-rs/macos-alias@^0.0.4"
  }
}
