{
  "name": "ouijit",
  "productName": "ouijit",
  "version": "1.11.0",
  "description": "Discover and manage your local development projects",
  "main": ".vite/build/main.cjs",
  "bin": {
    "ouijit": "./dist-cli/ouijit.js"
  },
  "scripts": {
    "prestart": "node scripts/build-cli.mjs",
    "start": "electron-forge start",
    "package": "npm run build:cli && electron-forge package",
    "make": "npm run build:cli && electron-forge make",
    "make:linux": "./scripts/build-linux.sh",
    "publish": "npm run build:cli && electron-forge release",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint src/ && prettier --check src/",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/build.mjs && npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:ci": "node e2e/build.mjs && xvfb-run npx playwright test --config e2e/playwright.config.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "docs:check": "node scripts/build-cli.mjs && node scripts/docs-check.mjs",
    "test:full": "vitest run && node e2e/build.mjs && npx playwright test --config e2e/playwright.config.ts",
    "postinstall": "{ [ \"$(uname)\" != Darwin ] || patch-package; } && ./scripts/download-nono.sh && chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "db:reset": "node scripts/dev-db.mjs reset",
    "db:seed": "node scripts/dev-db.mjs seed",
    "db:clone-prod": "node scripts/dev-db.mjs clone-prod",
    "capture": "node scripts/capture/run.mjs",
    "website": "npm --prefix website run dev",
    "website:build": "npm --prefix website run build"
  },
  "keywords": [],
  "author": "pbjer",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.2",
    "@floating-ui/react": "^0.27.20",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dompurify": "^3.0.5",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@xterm/headless": "^6.0.0",
    "electron": "45.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react-hotkeys-hook": "^5.4.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@linear/sdk": "^101.1.0",
    "@phosphor-icons/core": "^2.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.1.0",
    "dompurify": "^3.4.17",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "fix-path": "^5.0.0",
    "hotkeys-js": "^4.1.2",
    "koffi": "^3.3.7",
    "launch-editor": "^2.14.2",
    "marked": "^18.2.0",
    "mermaid": "^12.3.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "tar": "^7.5.7",
    "tmp": "^0.2.5",
    "@xmldom/xmldom": "^0.8.13",
    "lodash": "^4.18.1",
    "fast-uri": "^3.1.2",
    "ip-address": "^10.2.0",
    "make-fetch-happen": "^15.0.5",
    "macos-alias": "npm:@napi-rs/macos-alias@^0.0.4",
    "@electron/asar@4": {
      "minimatch": "^11.0.5",
      "glob": "^14.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "appdmg": {
      "image-size": "^2.1.0"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    }
  }
}
